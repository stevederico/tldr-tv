{
  "name": "tldr-tv",
  "private": false,
  "version": "0.109.0",
  "skateboardVersion": "5.6.0",
  "type": "module",
  "scripts": {
    "start": "vite --mode development",
    "front": "vite --mode development",
    "build": "npm run typecheck && vite build --mode production",
    "prod": "npm run typecheck && vite build --mode production",
    "install-all": "npm install",
    "postinstall": "git config core.hooksPath .githooks || true",
    "test": "npm run typecheck && npm run test:build && npm run test:docs && npm run test:utils",
    "typecheck": "tsc -p tsconfig.json",
    "verify:ui": "node scripts/verify-ui-version.mjs",
    "test:build": "node --experimental-test-module-mocks --test vite.plugins.test.js scripts/verify-ui-version.test.js scripts/update-skateboard.test.js scripts/version-consistency.test.js extension/extract.test.js",
    "test:utils": "node --experimental-strip-types --test src/utils/playerUtils.test.ts",
    "test:docs": "node scripts/test-docs.mjs"
  },
  "dependencies": {
    "@stevederico/skateboard-ui": "5.1.0",
    "lucide-react": "0.546.0",
    "onnxruntime-node": "1.21.0",
    "phonemizer": "1.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "trustedDependencies": [
    "@swc/core",
    "onnxruntime-node"
  ]
}
